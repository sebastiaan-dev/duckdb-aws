# name: test/sql/env/aws_secret_bug_source_profile.test
# description: reproducer for source_profile being ignored by STS
# group: [env]

require aws

require httpfs

require-env DUCKDB_AWS_SECRET_BUG_REPRO 1

# The local STS test server returns a different role credential depending on
# the access key used to sign AssumeRole. Current HEAD uses AWS_PROFILE rather
# than the role profile's source_profile.
statement ok
CREATE OR REPLACE SECRET aws_bug_source_profile (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'config',
    PROFILE 'role-repro',
    REGION 'us-east-1',
    VALIDATION 'exists'
);

query II
SELECT secret_string LIKE '%key_id=WRONG_ASSUMED%',
       secret_string LIKE '%key_id=SOURCE_ASSUMED%'
FROM duckdb_secrets(redact=false)
WHERE name = 'aws_bug_source_profile';
----
true	false
