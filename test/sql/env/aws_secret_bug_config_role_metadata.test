# name: test/sql/env/aws_secret_bug_config_role_metadata.test
# description: reproducer for config-role refresh metadata
# group: [env]

require aws

require httpfs

require-env DUCKDB_AWS_SECRET_BUG_REPRO 1

# Config-role STS credentials are temporary, but current HEAD does not add
# refresh_info and serializes the SDK's max-time expiration sentinel.
statement ok
CREATE OR REPLACE SECRET aws_bug_config_role_metadata (
    TYPE S3,
    PROVIDER credential_chain,
    CHAIN 'config',
    PROFILE 'role-repro',
    REGION 'us-east-1',
    VALIDATION 'exists'
);

query III
SELECT secret_string LIKE '%refresh_info=%',
       secret_string LIKE '%expiration_epoch_ms=9223372036854775%',
       secret_string LIKE '%key_id=WRONG_ASSUMED%'
FROM duckdb_secrets(redact=false)
WHERE name = 'aws_bug_config_role_metadata';
----
false	true	true
